# Compose publishes only nginx; the API stays on the Docker network.
# Open exactly http://127.0.0.1:8787 with the defaults below.
# Changing FI_PORT also changes the default canonical URL.
#FI_PORT=8787
# Set the actual browser origin when using another hostname or external HTTPS.
#ACCESS_PUBLIC_URL=https://your-service.example.com
# FI_PUBLIC_URL remains supported; if both URLs are set, their origins must match.

# 複製成 .env 再改。全部都可以不設。

# docker compose 對外的 port
#FI_PORT=8787

# 外部看到的網址（表單網址、通知信裡的連結用它組）
#FI_PUBLIC_URL=https://inbox.example.com

# 前面有反向代理（nginx、Caddy、Cloudflare…）時設 true
#FI_TRUST_PROXY=true

# 通知信：一般的 SMTP 服務
#FI_SMTP_HOST=smtp.example.com
#FI_SMTP_PORT=587
#FI_SMTP_USERNAME=
#FI_SMTP_PASSWORD=
#FI_SMTP_FROM=Feedback Inbox <inbox@example.com>
#FI_SMTP_TLS=starttls

# 通知信：先用內附的假信箱試（docker compose --profile mail up -d，信在 http://localhost:8025）
#FI_SMTP_HOST=mailpit
#FI_SMTP_PORT=1025
#FI_SMTP_FROM=Feedback Inbox <inbox@example.com>
#FI_SMTP_TLS=none

# Public OAuth client registration is optional; administrator registration stays available.
ACCESS_DYNAMIC_CLIENT_REGISTRATION=false

# Optional provider credentials; callback paths are /oauth/callback/github and /oauth/callback/google.
#ACCESS_GITHUB_CLIENT_ID=
#ACCESS_GITHUB_CLIENT_SECRET=
#ACCESS_GOOGLE_CLIENT_ID=
#ACCESS_GOOGLE_CLIENT_SECRET=

# Optional AI and verified member identity. Generate once with: openssl rand -base64 32
# Back this key up separately from SQLite; losing it prevents credential decryption.
#FI_AI_SECRET_KEY=
# Docker local Ollama may need http://host.docker.internal:11434; only list trusted origins.
#FI_AI_ALLOWED_OLLAMA_ORIGINS=http://127.0.0.1:11434
#FI_AI_CONCURRENCY=2
# Separate deployment kill switch; site activation and approved rules are still required.
#FI_AI_AUTO_SEND_ENABLED=false
