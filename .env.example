# 複製成 .env 再改。全部都可以不設。

# docker compose 對外的 port
#FI_PORT=8787

# 外部看到的網址（表單網址、通知信裡的連結用它組）
#FI_PUBLIC_URL=https://inbox.example.com

# 前面有反向代理（nginx、Caddy、Cloudflare…）時設 true
#FI_TRUST_PROXY=true

# 通知信：一般的 SMTP 服務
#FI_SMTP_HOST=smtp.example.com
#FI_SMTP_PORT=587
#FI_SMTP_USERNAME=
#FI_SMTP_PASSWORD=
#FI_SMTP_FROM=Feedback Inbox <inbox@example.com>
#FI_SMTP_TLS=starttls

# 通知信：先用內附的假信箱試（docker compose --profile mail up -d，信在 http://localhost:8025）
#FI_SMTP_HOST=mailpit
#FI_SMTP_PORT=1025
#FI_SMTP_FROM=Feedback Inbox <inbox@example.com>
#FI_SMTP_TLS=none
